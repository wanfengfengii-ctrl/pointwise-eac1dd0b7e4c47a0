{
  "version": 1,
  "kind": "api",
  "setup": [
    "python3",
    "-B",
    "ops.py",
    "bootstrap",
    "--state",
    "var/state",
    "--release",
    "r1",
    "--build-dir",
    "var/artifacts"
  ],
  "start": [
    "python3",
    "-B",
    "ops.py",
    "run",
    "--state",
    "var/state",
    "--host",
    "${POINTWISE_HOST}",
    "--port",
    "${POINTWISE_PORT}"
  ],
  "readiness_path": "/health",
  "verify": [
    "python3",
    "-B",
    "ops.py",
    "verify",
    "--state",
    "var/state"
  ],
  "demo": [
    "python3",
    "-B",
    "ops.py",
    "demo",
    "--workdir",
    "var/demo"
  ]
}
